<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="easybot">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import easybot urdf file -->
    <xacro:include filename="$(find easybot_description)/urdf/gzbot.urdf" />

    <!-- Import control_xacro -->
    <xacro:include filename="easybot.ros2_control.xacro" />


    <xacro:easybot_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
